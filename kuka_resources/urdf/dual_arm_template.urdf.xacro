<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="dual_arm">
  <!-- Global arguments -->
  <xacro:arg name="mode" default="hardware"/>
  <xacro:arg name="driver_version" default="rsi_only"/>

  <!-- Robot A arguments -->
  <xacro:arg name="robot_a_model" default="kr6_r700_sixx"/>
  <xacro:arg name="robot_a_family" default="agilus"/>
  <xacro:arg name="robot_a_prefix" default="robot_a_"/>
  <xacro:arg name="robot_a_x" default="0"/>
  <xacro:arg name="robot_a_y" default="0"/>
  <xacro:arg name="robot_a_z" default="0"/>
  <xacro:arg name="robot_a_roll" default="0"/>
  <xacro:arg name="robot_a_pitch" default="0"/>
  <xacro:arg name="robot_a_yaw" default="0"/>
  <xacro:arg name="robot_a_client_ip" default="0.0.0.0"/>
  <xacro:arg name="robot_a_client_port" default="59152"/>
  <xacro:arg name="robot_a_mxa_client_port" default="1337"/>
  <xacro:arg name="robot_a_controller_ip" default="0.0.0.0"/>
  <xacro:arg name="robot_a_roundtrip_time" default="4000"/>
  <xacro:arg name="robot_a_use_gpio" default="false"/>
  <xacro:arg name="robot_a_verify_robot_model" default="true"/>
  <xacro:arg name="robot_a_rsi_xml_config_file" default=""/>
  <xacro:arg name="robot_a_async_thread_priority" default="69"/>
  <xacro:arg name="robot_a_async_affinity" default="[]"/>

  <!-- Robot B arguments -->
  <xacro:arg name="robot_b_model" default="kr6_r700_sixx"/>
  <xacro:arg name="robot_b_family" default="agilus"/>
  <xacro:arg name="robot_b_prefix" default="robot_b_"/>
  <xacro:arg name="robot_b_x" default="0"/>
  <xacro:arg name="robot_b_y" default="1.0"/>
  <xacro:arg name="robot_b_z" default="0"/>
  <xacro:arg name="robot_b_roll" default="0"/>
  <xacro:arg name="robot_b_pitch" default="0"/>
  <xacro:arg name="robot_b_yaw" default="0"/>
  <xacro:arg name="robot_b_client_ip" default="0.0.0.0"/>
  <xacro:arg name="robot_b_client_port" default="59153"/>
  <xacro:arg name="robot_b_mxa_client_port" default="1338"/>
  <xacro:arg name="robot_b_controller_ip" default="0.0.0.0"/>
  <xacro:arg name="robot_b_roundtrip_time" default="4000"/>
  <xacro:arg name="robot_b_use_gpio" default="false"/>
  <xacro:arg name="robot_b_verify_robot_model" default="true"/>
  <xacro:arg name="robot_b_rsi_xml_config_file" default=""/>
  <xacro:arg name="robot_b_async_thread_priority" default="69"/>
  <xacro:arg name="robot_b_async_affinity" default="[]"/>

  <!-- Resolve package/file properties for robot A -->
  <xacro:property name="robot_a_family_value" value="$(arg robot_a_family)"/>
  <xacro:property name="robot_a_model_value" value="$(arg robot_a_model)"/>
  <xacro:property name="robot_a_support_package" value="${'kuka_' + robot_a_family_value + '_support'}"/>
  <xacro:property name="robot_a_urdf_dir" value="$(find ${robot_a_support_package})/urdf"/>
  <xacro:property name="robot_a_ros2_control_macro_name" value="${'kuka_' + robot_a_family_value + '_ros2_control'}"/>
  <xacro:property name="robot_a_model_macro_name" value="${'kuka_' + robot_a_model_value + '_robot'}"/>
  <xacro:property name="robot_a_prefix_value" value="$(arg robot_a_prefix)"/>

  <!-- Resolve package/file properties for robot B -->
  <xacro:property name="robot_b_family_value" value="$(arg robot_b_family)"/>
  <xacro:property name="robot_b_model_value" value="$(arg robot_b_model)"/>
  <xacro:property name="robot_b_support_package" value="${'kuka_' + robot_b_family_value + '_support'}"/>
  <xacro:property name="robot_b_urdf_dir" value="$(find ${robot_b_support_package})/urdf"/>
  <xacro:property name="robot_b_ros2_control_macro_name" value="${'kuka_' + robot_b_family_value + '_ros2_control'}"/>
  <xacro:property name="robot_b_model_macro_name" value="${'kuka_' + robot_b_model_value + '_robot'}"/>
  <xacro:property name="robot_b_prefix_value" value="$(arg robot_b_prefix)"/>

  <!-- Determine ros2_control macro file names -->
  <xacro:property name="robot_a_ros2_control_file" value="${'kr_' + robot_a_family_value + '_ros2_control_macro.xacro' if not robot_a_family_value.startswith('lbr_') else robot_a_family_value + '_ros2_control_macro.xacro'}"/>
  <xacro:property name="robot_b_ros2_control_file" value="${'kr_' + robot_b_family_value + '_ros2_control_macro.xacro' if not robot_b_family_value.startswith('lbr_') else robot_b_family_value + '_ros2_control_macro.xacro'}"/>

  <!-- Include macro files for both robots -->
  <xacro:include filename="${robot_a_urdf_dir}/${robot_a_model_value}_macro.xacro"/>
  <xacro:include filename="${robot_a_urdf_dir}/${robot_a_ros2_control_file}"/>
  <xacro:include filename="${robot_b_urdf_dir}/${robot_b_model_value}_macro.xacro"/>
  <xacro:include filename="${robot_b_urdf_dir}/${robot_b_ros2_control_file}"/>

  <!-- ros2_control for Robot A (async) -->
  <xacro:call macro="${robot_a_ros2_control_macro_name}" name="${robot_a_prefix_value}$(arg robot_a_model)" driver_version="$(arg driver_version)" client_ip="$(arg robot_a_client_ip)" client_port="$(arg robot_a_client_port)" mxa_client_port="$(arg robot_a_mxa_client_port)" controller_ip="$(arg robot_a_controller_ip)" prefix="$(arg robot_a_prefix)" use_gpio="$(arg robot_a_use_gpio)" mode="$(arg mode)" roundtrip_time="$(arg robot_a_roundtrip_time)" verify_robot_model="$(arg robot_a_verify_robot_model)" rsi_xml_config_file="$(arg robot_a_rsi_xml_config_file)" is_async="true" async_thread_priority="$(arg robot_a_async_thread_priority)" async_affinity="$(arg robot_a_async_affinity)">
    <ext_axes_ros2_control_joints/>
  </xacro:call>

  <!-- ros2_control for Robot B (async) -->
  <xacro:call macro="${robot_b_ros2_control_macro_name}" name="${robot_b_prefix_value}$(arg robot_b_model)" driver_version="$(arg driver_version)" client_ip="$(arg robot_b_client_ip)" client_port="$(arg robot_b_client_port)" mxa_client_port="$(arg robot_b_mxa_client_port)" controller_ip="$(arg robot_b_controller_ip)" prefix="$(arg robot_b_prefix)" use_gpio="$(arg robot_b_use_gpio)" mode="$(arg mode)" roundtrip_time="$(arg robot_b_roundtrip_time)" verify_robot_model="$(arg robot_b_verify_robot_model)" rsi_xml_config_file="$(arg robot_b_rsi_xml_config_file)" is_async="true" async_thread_priority="$(arg robot_b_async_thread_priority)" async_affinity="$(arg robot_b_async_affinity)">
    <ext_axes_ros2_control_joints/>
  </xacro:call>

  <!-- world link -->
  <link name="world"/>

  <!-- Robot A links and joints -->
  <xacro:call macro="${robot_a_model_macro_name}" prefix="$(arg robot_a_prefix)" package_name="${robot_a_support_package}"/>
  <joint name="${robot_a_prefix_value}world-base_link" type="fixed">
    <parent link="world"/>
    <child link="${robot_a_prefix_value}base_link"/>
    <origin xyz="$(arg robot_a_x) $(arg robot_a_y) $(arg robot_a_z)" rpy="$(arg robot_a_roll) $(arg robot_a_pitch) $(arg robot_a_yaw)"/>
  </joint>

  <!-- Robot B links and joints -->
  <xacro:call macro="${robot_b_model_macro_name}" prefix="$(arg robot_b_prefix)" package_name="${robot_b_support_package}"/>
  <joint name="${robot_b_prefix_value}world-base_link" type="fixed">
    <parent link="world"/>
    <child link="${robot_b_prefix_value}base_link"/>
    <origin xyz="$(arg robot_b_x) $(arg robot_b_y) $(arg robot_b_z)" rpy="$(arg robot_b_roll) $(arg robot_b_pitch) $(arg robot_b_yaw)"/>
  </joint>
</robot>
